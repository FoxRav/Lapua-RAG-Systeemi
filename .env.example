# === Tenant ==========================================================
LAPUA_TENANT=lapua

# === Storage =========================================================
# Root for ingested source PDFs and all per-document artefacts.
LAPUA_STORAGE_ROOT=F:/-DEV-/76.PaddleOCR/data/storage
LAPUA_INBOX_DIR=F:/-DEV-/76.PaddleOCR/data/inbox
LAPUA_INDEX_DIR=F:/-DEV-/76.PaddleOCR/data/index

# === Metadata DB =====================================================
# SQLite for MVP; swap to postgresql+psycopg://... for production.
LAPUA_DATABASE_URL=sqlite:///F:/-DEV-/76.PaddleOCR/data/index/metadata.sqlite

# === Qdrant ==========================================================
LAPUA_QDRANT_URL=http://localhost:6333
LAPUA_QDRANT_API_KEY=
LAPUA_QDRANT_COLLECTION=lapua_chunks

# === Embeddings =====================================================
# Multilingual E5 or BGE-M3. E5 is the faster default.
LAPUA_EMBEDDING_MODEL=intfloat/multilingual-e5-large
LAPUA_EMBEDDING_DEVICE=cpu
LAPUA_EMBEDDING_BATCH_SIZE=16

# === Reranker =======================================================
LAPUA_RERANKER_MODEL=BAAI/bge-reranker-v2-m3
LAPUA_RERANKER_DEVICE=cpu

# === LLM (Qwen + LoRA) ==============================================
LAPUA_LLM_BASE=Qwen/Qwen2.5-1.5B-Instruct
LAPUA_LLM_LORA=CCG-FAKTUM/lapua-llm-v2
LAPUA_LLM_DEVICE=cpu
LAPUA_LLM_DTYPE=bfloat16
LAPUA_LLM_MAX_NEW_TOKENS=256

# Optional remote vLLM server for heavy extraction / answer workloads.
# Set to http://localhost:8000/v1 when running vLLM in a WSL2 distro, or
# http://vllm:8000/v1 when using the docker-compose vllm service.
LAPUA_LLM_VLLM_URL=
# When vllm is launched with `--lora-modules <name>=<path>` the OpenAI payload
# must address the LoRA by that name (not the base HF id) to activate it.
LAPUA_LLM_VLLM_MODEL=lapua-v2

# === AnswerService ==================================================
# synth   = retrieve → rerank → vLLM extracts a JSON answer.
# retrieve= retrieve → rerank → return top-N cited chunks verbatim,
#           skipping the LLM. Use this when the synthesis model is
#           unreliable (e.g. lapua-llm-v2 overtrained-abstain — see
#           README §11) and the user is better served by reading the
#           cited evidence directly.
LAPUA_ANSWER_MODE=synth
LAPUA_ANSWER_MIN_SCORE=0.0
LAPUA_ANSWER_MAX_CONTEXT_CHUNKS=5
LAPUA_ANSWER_MAX_CHARS_PER_CHUNK=1500
# Per-source snippet length when ANSWER_MODE=retrieve (synth-mode uses 200).
LAPUA_ANSWER_RETRIEVE_SNIPPET_CHARS=600

# === OCR ============================================================
LAPUA_OCR_DEVICE=gpu:0
LAPUA_OCR_USE_VL_FALLBACK=true
LAPUA_OCR_VL_CONFIDENCE_THRESHOLD=0.6

# === API ============================================================
LAPUA_API_HOST=127.0.0.1
LAPUA_API_PORT=8080
LAPUA_API_CORS_ORIGINS=["http://localhost:3000"]

# === Observability ==================================================
LAPUA_LOG_LEVEL=INFO
LAPUA_LOG_FORMAT=json
